static func build_all() -> Dictionary:
	var out: Dictionary = {}
	for id in MAPS.keys():
		out[id] = ImageTexture.create_from_image(build_image(MAPS[id] as Array))
	return out


## Rows shorter than 16 are padded and longer rows are clipped, so a typo in
## a map can only misplace a pixel, never crash the game.
static func build_image(rows: Array) -> Image:
	var img := Image.create(SIZE, SIZE, false, Image.FORMAT_RGBA8)
	img.fill(Color(0, 0, 0, 0))
	for y in mini(rows.size(), SIZE):
		var row := String(rows[y])
		for x in mini(row.length(), SIZE):
			var ch := row[x]
			if PALETTE.has(ch):
				img.set_pixel(x, y, Color(String(PALETTE[ch])))
	return img
